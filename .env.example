# Copy to .env. Loaded by apps/studio, apps/api and packages/db scripts.

# Postgres. Leave as-is to use the bundled local Postgres started by `pnpm dev` (PB_LOCAL_DB=1).
# For Supabase: use the direct connection string and set PB_LOCAL_DB=0. Direct connections are
# IPv6-only on Supabase; on IPv4 networks use the session pooler (Connect → Session pooler, port 5432).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/photobooth
PB_LOCAL_DB=1
# Connections per process (Studio, API and worker each open a pool; default 10). The Supabase Free
# session pooler allows 15 clients in total, so use 4 there. Production: prefer the transaction
# pooler (port 6543; prepared statements are switched off automatically for pooler.supabase.com)
# and raise "Connection pool size" under Database → Settings (open-questions #52).
PB_DB_POOL_MAX=

# Auth mode: "dev" (local email+password, no Supabase needed) or "supabase".
PB_AUTH_MODE=dev
# Signs dev-mode session tokens. Any long random string. Never used when PB_AUTH_MODE=supabase.
DEV_AUTH_SECRET=change-me-dev-only-secret-at-least-32-chars

# Supabase (required when PB_AUTH_MODE=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# AES-256-GCM master key for secrets (32 bytes, base64). Only apps/api + apps/worker.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_MASTER_KEY=

API_PORT=8787

# F4 payments. Public base URL of apps/api (Midtrans notification URL = <this>/webhooks/midtrans/<orgId>).
# For a local sandbox test expose the API with a tunnel (e.g. cloudflared) and put that URL here.
PB_PUBLIC_API_URL=
# midtrans (default) or mock (dev without a Midtrans account; refused in production).
PB_PAYMENT_PROVIDER=midtrans

# F5 output + Google Drive (docs/testing/F5-manual.md has the Google Cloud setup).
# OAuth client (type "Web application"). The only scope requested is drive.file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI registered in Google Cloud; default <PB_PUBLIC_API_URL>/oauth/google/callback.
GOOGLE_REDIRECT_URI=
# Dev without a Google project: run `pnpm --filter @pb/drive fake` and set
# PB_GOOGLE_BASE_URL=http://127.0.0.1:9099 (with GOOGLE_CLIENT_ID/SECRET=fake).
PB_GOOGLE_BASE_URL=
# Where the OAuth callback sends the owner back to.
PB_STUDIO_URL=http://localhost:3000
# Object storage for session files: disk (dev, default .data/storage) or supabase
# (SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY, private bucket PB_STORAGE_BUCKET=sessions).
PB_STORAGE=disk
# Redis wakes the worker immediately (BullMQ). Without it the worker polls the job table.
REDIS_URL=
# ffmpeg binary for video/ (default: the bundled ffmpeg-static, else `ffmpeg` on PATH).
FFMPEG_PATH=
# Days to keep the storage copy after the Drive upload finished (open-questions #5).
PB_STORAGE_RETENTION_DAYS=30
# Agent: days to keep the local copy after a confirmed upload (0 = delete at once).
PB_LOCAL_RETENTION_DAYS=0

# F6 subscription billing: the PLATFORM's own Midtrans account (never an owner's; owners connect theirs in Studio).
# Subscription money goes here; buyer money goes to each owner's account. Server key from the platform's Midtrans dashboard.
PB_BILLING_MIDTRANS_SERVER_KEY=
PB_BILLING_MIDTRANS_ENV=sandbox
# Signature Secret Key of that account (Settings → Access Keys): verifies /webhooks/billing notifications
# (Midtrans signs with it since 2026-10-28). PREVIOUS = the replaced key while Midtrans still retries old ones.
PB_BILLING_MIDTRANS_SIGNATURE_KEY=
PB_BILLING_MIDTRANS_PREVIOUS_SIGNATURE_KEY=
# Dev without a Midtrans account: mock (refused in production). Pay with POST /dev/billing/invoices/:id/simulate-paid.
PB_BILLING_PROVIDER=
# Platform admins (e-mails, comma separated): see /admin in Studio. Set in the API and Studio environments.
PB_PLATFORM_ADMINS=

# Audit hardening (docs/audit-mvp.md).
# T1: where config assets may be fetched from by the worker (and saved/published from Studio).
# Default: <PB_MEDIA_BASE_URL>/media/ and <SUPABASE_URL>/storage/v1/object/public/assets/. Comma separated.
PB_ASSET_URL_PREFIXES=
# Studio's public URL for uploaded assets (dev disk storage). Also used for the default above.
PB_MEDIA_BASE_URL=http://localhost:3000
# S2: behind a reverse proxy, 1 = rate-limit by the first X-Forwarded-For address (else the socket address).
PB_TRUST_PROXY=
# R5: base URL of the /s/<code> short links (default PB_PUBLIC_API_URL). The kiosk uses VITE_SHORT_LINK_BASE.
PB_SHORT_LINK_BASE=

# F9 "Kirim hasil": the PLATFORM's own sender for every booth (owners set nothing). Worker only.
# WhatsApp Business Cloud API: permanent access token, phone number id, and an APPROVED template
# with two body parameters ({{1}} booth name, {{2}} link). Language default `id`.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=id
# E-mail via Resend; PB_EMAIL_FROM must be on a domain verified in Resend (SPF/DKIM).
RESEND_API_KEY=
PB_EMAIL_FROM=
# Dev: `log` prints messages instead of sending them.
PB_MESSAGING=
