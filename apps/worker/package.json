    "@pb/schema": "workspace:*",
    "@pb/storage": "workspace:*",
    "bullmq": "^6.7.8",
    "drizzle-orm": "^0.45.4",
    "ffmpeg-static": "^5.3.0",
    "hono": "^4.13.20",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@paralleldrive/cuid2": "^3.3.0"
