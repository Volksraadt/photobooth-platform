{
  "name": "@pb/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "BullMQ worker: session processing, Drive upload, billing jobs",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
